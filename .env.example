# Google Cloud / BigQuery
# Caminho para a chave de serviço (apenas local — no Cloud Run use a SA do serviço)
GOOGLE_APPLICATION_CREDENTIALS=./tensile-impact-486818-g9-9790f3e8374e.json
BQ_PROJECT_ID=your-gcp-project-id
BQ_DATASET=promozone
BQ_TABLE=promotions
BQ_STAGING_TABLE=promotions_staging

# Mercado Livre - consultas de coleta (JSON array)
# Cada entrada: {"query": "termo de busca", "source": "nome_da_fonte"}
ML_SOURCES='[{"query": "smartphone", "source": "busca_smartphone"}, {"query": "notebook", "source": "busca_notebook"}, {"query": "fone de ouvido", "source": "busca_fone"}]'

# Configurações opcionais
ML_MAX_ITEMS_PER_SOURCE=50
ML_REQUEST_DELAY_SECONDS=1.0
LOG_LEVEL=INFO
ENVIRONMENT=local
PORT=8080

